# Contoh konfigurasi lingkungan (jangan commit .env yang berisi nilai asli)
# Salin file ini menjadi .env lalu isi nilainya sesuai akun Anda.

# Coursera API
BASE_URL=https://www.coursera.org/api/
GRAPHQL_URL=https://www.coursera.org/graphql-gateway

# Session Cookie (gunakan dari browser login Anda)
CAUTH=

# Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# ---------------------------------------------------------------------------
# LLM dinamis (OpenAI-compatible): 9router, OpenRouter, Ollama, LM Studio, vLLM, dll.
# Provider yang didukung: gemini | openai | openrouter | 9router | local | perplexity
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
# Pakai 127.0.0.1 karena proxy lokal (Antigravity/9router) umumnya hanya bind ke loopback.
LLM_BASE_URL=http://127.0.0.1:8045/v1
LLM_API_KEY=
# Nama model di proxy lokal Anda (wajib untuk proxy Antigravity/9router ini).
# Model sehat saat dicek: gemini-3.8-flash-tiered, claude-sonnet-4-6-thinking, gpt-oss-120b-medium.
LLM_MODEL=gemini-3.8-flash-tiered

# Contoh pakai OpenRouter:
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=google/gemini-2.0-flash-001

# Headers opsional
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, seperti Gecko) Chrome/138.0.0.0 Safari/537.36
COURSERA_VERSION=3bfd497de04ae0fef167b747fd85a6fbc8fb55df

# # Perplexity
#PERPLEXITY_API_URL=https://api.perplexity.ai/chat/completions
#PERPLEXITY_MODEL=sonar-pro
#EMAIL =
#PASSWORD =
#PERPLEXITY_API_KEY =

