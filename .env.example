# Contoh konfigurasi lingkungan (jangan commit .env yang berisi nilai asli)
# Salin file ini menjadi .env lalu isi nilainya sesuai akun Anda.

# Coursera API
BASE_URL=https://www.coursera.org/api/
GRAPHQL_URL=https://www.coursera.org/graphql-gateway

# Session Cookie (gunakan dari browser login Anda)
CAUTH=

# ===========================================================================
# Konfigurasi LLM — bisa pakai model APAPUN dari provider APAPUN
# (Gemini, Claude, GPT, Llama, Qwen, dll) asal ada API key-nya.
# Provider yang didukung: gemini | openai | openrouter | 9router | local | perplexity
# ===========================================================================

# --- Cara A (disarankan): provider OpenAI-compatible ---
# Pilih SALAH SATU dari dua mode 9router di bawah (aktifkan yang dipakai,
# biarkan yang lain tetap diawali #).

# A1. 9router SERVER (remote — punya URL publik + butuh API key):
LLM_PROVIDER=9router
LLM_BASE_URL=https://9router.jos/v1
LLM_API_KEY=
LLM_MODEL=apa-aja-oke

# A2. 9router LOCAL (jalan di mesin ini, umumnya tanpa key):
# LLM_PROVIDER=9router
# LLM_BASE_URL=http://127.0.0.1:8045/v1
# LLM_API_KEY=
# LLM_MODEL=apa-aja-oke

# ---------------------------------------------------------------------------
# Nama model bebas — tidak harus Gemini. Bisa juga diisi NAMA COMBO 9Router
# (gabungan beberapa model jadi 1 endpoint). Contoh model satuan:
#   Gemini:  gemini-3.8-flash-tiered, gemini-3-flash-preview
#   Claude:  claude-sonnet-4-6-thinking, claude-opus-4
#   GPT:     gpt-oss-120b-medium, gpt-4o-mini
#   Llama:   llama-3.1-70b-instruct
#   Qwen:    qwen2.5-72b-instruct
# ---------------------------------------------------------------------------

# Contoh pakai OpenRouter (model apa saja):
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=anthropic/claude-sonnet-4
# (Bisa juga pakai env OPENROUTER_API_KEY sebagai pengganti LLM_API_KEY)

# Contoh pakai OpenAI langsung:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Contoh pakai lokal tanpa key (Ollama / LM Studio):
# LLM_PROVIDER=local
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen2.5:7b

# --- Cara B (opsional): API Gemini langsung dari Google (AI Studio) ---
# Dipakai hanya kalau LLM_PROVIDER=gemini atau LLM_PROVIDER + LLM_BASE_URL dikosongkan.
# Bisa juga pakai env GOOGLE_API_KEY sebagai pengganti GEMINI_API_KEY.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview

# Headers opsional
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, seperti Gecko) Chrome/138.0.0.0 Safari/537.36
COURSERA_VERSION=3bfd497de04ae0fef167b747fd85a6fbc8fb55df

