# ---------------------------------------------------------------------------
# Skipera - contoh konfigurasi lingkungan
# Salin file ini menjadi .env lalu isi nilainya:   cp .env.example .env
# File .env TIDAK ikut ter-commit (lihat .gitignore).
# ---------------------------------------------------------------------------

# ============================ WAJIB ========================================
# Cookie sesi Coursera (CAUTH). Cara ambil:
#   1. Login ke https://www.coursera.org di browser
#   2. Buka DevTools (F12) -> tab Application/Storage -> Cookies
#      -> pilih https://www.coursera.org -> cari baris "CAUTH"
#   3. Copy kolom Value, tempel di bawah.
# Kalau dibiarkan kosong, Skipera mencoba ambil otomatis dari browser
# (butuh paket browser_cookie3 dan browser dalam keadaan tertutup).
CAUTH=

# ==================== LLM: PILIH SALAH SATU ================================
# Ambil Gemini API key di: https://aistudio.google.com/apikey
# Kalau diisi, cukup jalankan:  python main.py <course-slug> --llm
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# --- (Alternatif) AI lokal OpenAI-compatible: Antigravity / 9router / Ollama / LM Studio ---
# Uncomment 4 baris di bawah, lalu jalankan:
#   python main.py <course-slug> --llm --provider local
# LLM_PROVIDER=local
# LLM_BASE_URL=http://127.0.0.1:8045/v1
# LLM_API_KEY=
# LLM_MODEL=gemini-3.8-flash-tiered

# --- (Alternatif) OpenRouter ---
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=google/gemini-2.0-flash-001
